# Backend Staging/Production Environment Variables
PORT=5000
NODE_ENV=production

# Database
MONGO_URI=mongodb://mongodb:27017/medichain
REDIS_URL=redis://redis:6379

# Authentication Secrets (Must be 64+ char cryptographically secure random strings)
JWT_SECRET=your_jwt_secret_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_placeholder
SESSION_SECRET=your_session_secret_placeholder

# Smart Contract Integration
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=your_private_key_placeholder
CONTRACT_ADDRESS=your_deployed_contract_address

# IPFS Integration (Pinata)
PINATA_JWT=your_pinata_jwt_placeholder
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# File Encryption (Must be 64-char hex string)
ENCRYPTION_MASTER_KEY=your_encryption_master_key_placeholder

# Microservice Endpoints
AI_SERVICE_URL=http://ai:5001

# SMTP Email Settings (MailHog for local staging)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@medichain.local
